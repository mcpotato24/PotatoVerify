# 필수: Discord Developer Portal에서 발급한 비어 있지 않은 봇 토큰
DISCORD_TOKEN=your_discord_bot_token

# 필수: 슬래시 명령어를 등록할 Discord 서버 ID (17~20자리 숫자)
GUILD_ID=123456789012345678

# 필수: 관리자, 인증 완료, 미인증 역할 ID (각각 서로 다른 17~20자리 숫자)
ADMIN_ROLE_ID=123456789012345679
VERIFIED_ROLE_ID=123456789012345680
UNVERIFIED_ROLE_ID=123456789012345681

# 선택: SQLite DB 경로 (기본값: 프로젝트 루트의 user-data.sqlite, 상대경로는 프로젝트 루트 기준)
DATABASE_PATH=user-data.sqlite
